# LiveKit Cloud project credentials. Copy this file to .env and fill in the values.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret

# LLM: OpenRouter model ID. This sample uses the model requested for this project.
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_API_KEY=

# STT and TTS: LiveKit Inference model IDs and voice ID.
STT_MODEL=
TTS_MODEL=
TTS_VOICE=

# Optional Gmail OAuth files (paths relative to Test-LiveKit)
GMAIL_CLIENT_SECRET_FILE=.secrets/gmail-client.json
GMAIL_TOKEN_FILE=.secrets/gmail-token.json

# Optional observability: traces are exported to Langfuse over OpenTelemetry.
# PII such as transcripts, Gmail content, and tool arguments is excluded.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
# Set to true only when you intentionally want conversational/tool payloads in Langfuse Messages.
LANGFUSE_ALLOW_PII=false
PROMPT_VERSION=v1

# Local prompt version and pseudonymous user identifier (never an email address).
SYSTEM_PROMPT_VERSION=v2
LOCAL_USER_ID=local-user
# Optional JSON file of per-model USD rates. No configured rates means no app cost estimate.
OBSERVABILITY_PRICES_FILE=prices.json

# Level 2 Agent Memory (PostgreSQL + pgvector + Ollama)
DATABASE_URL=postgresql+psycopg://localhost:5432/care_support
TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/care_support_test
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma-2:270m
EMBEDDING_DIMENSION=768
MEMORY_SEARCH_LIMIT=5
MEMORY_PROMPT_RECENT_LIMIT=5
MEMORY_SIMILARITY_THRESHOLD=0.0
DEFAULT_MEMORY_USER_ID=default-user

# --- Level 3 RAG (PostgreSQL + pgvector + Ollama) ---
RAG_CHUNK_SIZE=450
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.0
# Optional dedicated LLM overrides for memory extraction/consolidation (falls back to OPENROUTER_*)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
MEMORY_LLM_MODEL=

# --- Level 3B Web Search (Tavily) ---
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=10
TAVILY_MAX_RESULTS=5
TAVILY_MAX_SEARCHES_PER_SESSION=5

# --- TEST-Secretary Mode & DeepEval ---
# AGENT_MODE=secretary (optional; frontend-test-secretary-* rooms enable secretary mode automatically)
AGENT_MODE=
EVAL_JUDGE_MODEL=
