# LiveKit Cloud project credentials. Copy this file to .env and fill in the values.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret

# LLM: OpenRouter model ID. This sample uses the model requested for this project.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_API_KEY=

# STT and TTS: LiveKit Inference model IDs and voice ID.
STT_MODEL=
TTS_MODEL=
TTS_VOICE=

# Optional Gmail OAuth files (paths relative to Test-LiveKit)
GMAIL_CLIENT_SECRET_FILE=.secrets/gmail-client.json
GMAIL_TOKEN_FILE=.secrets/gmail-token.json
