{
  "$schema": "./cloudflare/node_modules/wrangler/config-schema.json",
  "name": "care-support-voice-agent",
  "main": "cloudflare/src/index.ts",
  "compatibility_date": "2026-11-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./fronted-test/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "containers": [
    {
      "class_name": "LiveKitAgent",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVEKIT_AGENT",
        "class_name": "LiveKitAgent"
      }
    ]
  },
  "exports": {
    "LiveKitAgent": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
